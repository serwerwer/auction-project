DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True

# PostgreSQL database configuration
# Each developer should set their own credentials in the local .env file
POSTGRES_DB=auction_dev
POSTGRES_USER=auction_dev
POSTGRES_PASSWORD=replace_with_your_own_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432